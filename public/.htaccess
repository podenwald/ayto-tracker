# Nachbildung von _headers und _redirects (Netlify-Format) für Apache,
# da das tatsächliche Hosting (netcup/Plesk) diese Dateien nicht auswertet.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"

  # Saison-/Versionsdaten dürfen nie stale aus dem Cache kommen
  <FilesMatch "\.json$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  # Service Worker: ohne diesen Header bleiben Browser auf altem Build hängen
  <Files "sw.js">
    Header always set Cache-Control "no-store"
  </Files>

  <Files "manifest.webmanifest">
    Header always set Cache-Control "public, max-age=3600"
  </Files>

  <FilesMatch "^pwa-.*\.png$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Echte Dateien/Verzeichnisse (json/, assets/, Icons, Manifest, ...) unverändert durchlassen
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA-Fallback: alle anderen Pfade (z. B. /admin) auf index.html
  RewriteRule ^ index.html [L]
</IfModule>
